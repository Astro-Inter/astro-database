  "modeling": {
    "principles": [
      {
        "title": "Nomes físicos",
        "description": "Coleções e campos em português, snake_case. Referências terminam em _id; listas de referências em _ids. _id, _class e operadores BSON são metadados técnicos preservados."
      },
      {
        "title": "Contratos e mapeamento",
        "description": "A convenção física do Mongo não obriga renomear Java, DTOs HTTP, protocolos LLM ou payloads Qdrant. Mapear explicitamente na persistência."
      },
      {
        "title": "Formulários",
        "description": "Uma coleção formularios, com um documento por formulário, perguntas/respostas/configuracao embutidas e escopo por workspace."
      },
      {
        "title": "Datas e identificadores",
        "description": "Datas de instante em BSON date; preservar tipos de IDs. usuario_id de sessão é UID Firebase; usuario_id de notificação é ID numérico PostgreSQL."
      }
    ],
    "decisions": [
      {
        "title": "Migração coordenada",
        "description": "Simular e verificar conflitos, interromper todos os escritores, preservar backup BSON e índices, migrar e disponibilizar versões compatíveis. Não executar contra serviços antigos ativos."
      },
      {
        "title": "Mensagens da IA",
        "description": "A ferramenta IA usa remetente/destinatário; a API Java usa conversa_id. A padronização não inventa conversas para registros legados sem esse vínculo."
      },
      {
        "title": "Dashboards",
        "description": "Fora desta etapa; nenhuma coleção de dashboards foi criada."
      }
    ]
  },
  "issues": []
