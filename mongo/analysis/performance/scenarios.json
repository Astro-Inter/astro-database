  {
    "id": "java_formularios_home",
    "source": "FormRepository.findTop3PendingByManagerId",
    "collection": "formularios",
    "command": {
      "aggregate": "formularios",
      "pipeline": [
        {
          "$match": {
            "gestor_id": 3,
            "status": "PENDENTE"
          }
        },
        {
          "$addFields": {
            "_due_date_missing": {
              "$cond": [
                {
                  "$eq": [
                    {
                      "$ifNull": [
                        "$data_limite",
                        null
                      ]
                    },
                    null
                  ]
                },
                1,
                0
              ]
            }
          }
        },
        {
          "$sort": {
            "_due_date_missing": 1,
            "data_limite": 1,
            "_id": 1
          }
        },
        {
          "$limit": 3
        },
        {
          "$project": {
            "_id": 1,
            "titulo": 1,
            "data_limite": 1
          }
        }
      ],
      "cursor": {}
    },
    "note": "A chave de ordenação calculada _due_date_missing não existe no documento; o índice não elimina este Sort."
  },
  {
    "id": "ia_sessoes_lista",
    "source": "database/sessions.py:MongoSessions.list_sessions (pipeline extraído do código)",
    "collection": "sessoes",
    "command": {
      "aggregate": "sessoes",
      "pipeline": [
        {
          "$match": {
            "usuario_id": "<SESSIONUID>"
          }
        },
        {
          "$sort": {
            "atualizada_em": -1,
            "_id": -1
          }
        },
        {
          "$limit": 11
        },
        {
          "$project": {
            "iniciada_em": 1,
            "atualizada_em": 1,
            "status": 1,
            "titulo": 1,
            "ultima_mensagem_previa": 1,
            "primeira_pergunta": {
              "$arrayElemAt": [
                {
                  "$filter": {
                    "input": {
                      "$ifNull": [
                        "$mensagens",
                        []
                      ]
                    },
                    "as": "message",
                    "cond": {
                      "$and": [
                        {
                          "$eq": [
                            "$$message.papel",
                            "human"
                          ]
                        },
                        {
                          "$eq": [
                            {
                              "$type": "$$message.conteudo"
                            },
                            "string"
                          ]
                        }
                      ]
                    }
                  }
                },
                0
              ]
            },
            "ultima_mensagem": {
              "$arrayElemAt": [
                {
                  "$filter": {
                    "input": {
                      "$ifNull": [
                        "$mensagens",
                        []
                      ]
                    },
                    "as": "message",
                    "cond": {
                      "$and": [
                        {
                          "$in": [
                            "$$message.papel",
                            [
                              "human",
                              "assistant"
                            ]
                          ]
                        },
                        {
                          "$eq": [
                            {
                              "$type": "$$message.conteudo"
                            },
                            "string"
                          ]
                        }
                      ]
                    }
                  }
                },
                -1
              ]
            }
          }
        }
      ],
      "cursor": {}
    },
    "note": ""
  },
  {
    "id": "ia_memoria_resumos",
    "source": "database/sessions.py:MongoSessions.previous",
    "collection": "sessoes",
    "command": {
      "find": "sessoes",
      "filter": {
        "usuario_id": "<SUMMARYUID>",
        "_id": {
          "$ne": "<SESSIONID>"
        },
        "status": {
          "$in": [
            "ativa",
            "encerrada"
          ]
        },
        "resumo": {
          "$type": "string",
          "$ne": ""
        },
        "$or": [
          {
            "status": "encerrada",
            "resumo_mensagens": {
              "$exists": false
            }
          },
          {
            "$expr": {
              "$and": [
                {
                  "$eq": [
                    "$resumo_mensagens",
                    {
                      "$size": {
                        "$ifNull": [
                          "$mensagens",
                          []
                        ]
                      }
                    }
                  ]
                },
                {
                  "$eq": [
                    "$resumo_ultima_mensagem_em",
                    {
                      "$ifNull": [
                        "$ultima_mensagem_em",
                        "$atualizada_em"
                      ]
                    }
                  ]
                }
              ]
            }
          }
        ]
      },
      "sort": {
        "atualizada_em": -1
      },
      "limit": 3,
      "projection": {
        "resumo": 1,
        "iniciada_em": 1,
        "mensagens": {
          "$slice": -6
        }
      }
    },
    "note": ""
  },
