  {
    "id": "java_chat_ultima_por_conversa",
    "source": "ChatMongoRepository.findLatestMessages",
    "collection": "mensagens",
    "command": {
      "aggregate": "mensagens",
      "pipeline": [
        {
          "$match": {
            "conversa_id": {
              "$in": [
                "<CONVERSATION>",
                "<IDENTIFIER_2>"
              ]
            }
          }
        },
        {
          "$sort": {
            "data": -1,
            "_id": -1
          }
        },
        {
          "$group": {
            "_id": "$conversa_id",
            "senderId": {
              "$first": "$remetente_id"
            },
            "content": {
              "$first": "$mensagem"
            },
            "date": {
              "$first": "$data"
            }
          }
        },
        {
          "$project": {
            "senderId": 1,
            "content": 1,
            "date": 1,
            "conversationId": "$_id"
          }
        }
      ],
      "cursor": {}
    },
    "note": ""
  },
