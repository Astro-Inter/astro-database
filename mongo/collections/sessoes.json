{
  "name": "sessoes",
  "title": "Sessões de chatbot",
  "description": "Histórico por proprietário, mensagens e controle dos resumos.",
  "status": "Implementada",
  "pattern": "Documentos e referências",
  "fields": [
    {
      "name": "_id",
      "type": "string",
      "description": "UUID da sessão.",
      "required": "Sim"
    },
    {
      "name": "usuario_id",
      "type": "string",
      "description": "UID Firebase do proprietário; não é o ID numérico PostgreSQL.",
      "required": "Sim"
    },
    {
      "name": "iniciada_em",
      "type": "date",
      "description": "Início da sessão.",
      "required": "Não"
    },
    {
      "name": "atualizada_em",
      "type": "date",
      "description": "Última atualização.",
      "required": "Não"
    },
    {
      "name": "ultima_mensagem_em",
      "type": "date",
      "description": "Última mensagem; base da inatividade.",
      "required": "Não"
    },
    {
      "name": "encerrada_em",
      "type": "date",
      "description": "Encerramento quando aplicável.",
      "required": "Não"
    },
    {
      "name": "titulo",
      "type": "string",
      "description": "Título resumido da conversa.",
      "required": "Não"
    },
    {
      "name": "ultima_mensagem_previa",
      "type": "string",
      "description": "Prévia para listagem.",
      "required": "Não"
    },
    {
      "name": "status",
      "type": "string",
      "description": "ativa, encerrando ou encerrada.",
      "required": "Não"
    },
    {
      "name": "ultima_rota",
      "type": "string",
      "description": "Última rota do agente.",
      "required": "Não"
    },
    {
      "name": "acao_pendente",
      "type": "object | null",
      "description": "Rascunho de ação que exige confirmação explícita; mensagem_id, remetente_id, destinatario_id e sessao_id quando presentes.",
      "required": "Não"
    },
    {
      "name": "mensagens",
      "type": "array<object>",
      "description": "Histórico embutido.",
      "required": "Sim"
    },
    {
      "name": "mensagens[].papel",
      "type": "string",
      "description": "human ou assistant; valores do protocolo interno.",
      "required": "Não"
    },
    {
      "name": "mensagens[].conteudo",
      "type": "string",
      "description": "Texto da mensagem.",
      "required": "Não"
    },
    {
      "name": "mensagens[].blocos",
      "type": "array<object>",
      "description": "Blocos estruturados em português: tipo, conteudo, titulo, dados etc.",
      "required": "Não"
    },
    {
      "name": "resumo",
      "type": "string",
      "description": "Resumo da conversa.",
      "required": "Não"
    },
    {
      "name": "resumo_parcial",
      "type": "string",
      "description": "Checkpoint do resumo manual.",
      "required": "Não"
    },
    {
      "name": "resumo_ate",
      "type": "number",
      "description": "Posição do resumo manual.",
      "required": "Não"
    },
    {
      "name": "resumo_indexado",
      "type": "boolean",
      "description": "Resumo atual indexado no serviço vetorial.",
      "required": "Não"
    },
    {
      "name": "resumo_mensagens",
      "type": "number",
      "description": "Quantidade de mensagens representadas pelo resumo.",
      "required": "Não"
    },
    {
      "name": "resumo_ultima_mensagem_em",
      "type": "date",
      "description": "Versão temporal resumida.",
      "required": "Não"
    },
    {
      "name": "resumo_gerado_em",
      "type": "date",
      "description": "Geração do resumo.",
      "required": "Não"
    },
    {
      "name": "resumo_origem",
      "type": "string",
      "description": "Origem, como automatico.",
      "required": "Não"
    },
    {
      "name": "reserva_token",
      "type": "string",
      "description": "Token temporário de exclusão mútua.",
      "required": "Não"
    },
    {
      "name": "reserva_ate",
      "type": "date",
      "description": "Validade da reserva do chat.",
      "required": "Não"
    },
    {
      "name": "resumo_tarefa_token",
      "type": "string",
      "description": "Token da tarefa.",
      "required": "Não"
    },
    {
      "name": "resumo_tarefa_ate",
      "type": "date",
      "description": "Validade da reserva.",
      "required": "Não"
    },
    {
      "name": "resumo_tarefa_tentativas",
      "type": "number",
      "description": "Quantidade de tentativas.",
      "required": "Não"
    },
    {
      "name": "resumo_tarefa_proxima_tentativa",
      "type": "date",
      "description": "Próxima tentativa permitida.",
      "required": "Não"
    },
    {
      "name": "resumo_tarefa_erro",
      "type": "string",
      "description": "Código sanitizado da falha.",
      "required": "Não"
    },
    {
      "name": "resumo_automatico_parcial",
      "type": "string",
      "description": "Checkpoint do serviço de resumo automático.",
      "required": "Não"
    },
    {
      "name": "resumo_automatico_ate",
      "type": "number",
      "description": "Checkpoint do serviço de resumo automático.",
      "required": "Não"
    },
    {
      "name": "resumo_automatico_base_em",
      "type": "date",
      "description": "Checkpoint do serviço de resumo automático.",
      "required": "Não"
    },
    {
      "name": "resumo_automatico_base_total",
      "type": "number",
      "description": "Checkpoint do serviço de resumo automático.",
      "required": "Não"
    },
    {
      "name": "consulta_rh",
      "type": "object",
      "description": "Estado da última consulta RH: consulta, tipos, status, cargo, nome, pagina e limite.",
      "required": "Não"
    },
    {
      "name": "ultimo_pdf",
      "type": "object",
      "description": "Último documento gerado.",
      "required": "Não"
    },
    {
      "name": "ultimo_pdf.url",
      "type": "string",
      "description": "URL temporária de download.",
      "required": "Não"
    },
    {
      "name": "ultimo_pdf.expira_em",
      "type": "date | string",
      "description": "Validade do download, preservando o formato do produtor.",
      "required": "Não"
    }
  ],
  "example": {
    "_id": "11111111-2222-4333-8444-555555555555",
    "usuario_id": "uid-ficticio",
    "iniciada_em": {
      "$date": "2026-10-30T15:00:00Z"
    },
    "atualizada_em": {
      "$date": "2026-10-30T15:00:00Z"
    },
    "ultima_mensagem_em": {
      "$date": "2026-10-30T15:00:00Z"
    },
    "status": "ativa",
    "acao_pendente": null,
    "mensagens": [
      {
        "papel": "human",
        "conteudo": "Olá!"
      }
    ],
    "resumo": "",
    "resumo_indexado": false
  },
  "notes": [
    "Escritores: astro-ai-api e astro-session-summary-service; ambos precisam da mesma versão do esquema.",
    "id_user vira usuario_id; role/content viram papel/conteudo somente nas mensagens persistidas.",
    "O contrato HTTP e os payloads do provedor LLM/Qdrant continuam com seus nomes próprios; o repositório faz a tradução.",
    "lock_token/lock_ate viram reserva_token/reserva_ate; resumo_job_* vira resumo_tarefa_*.",
    "As definições de índices foram conferidas no banco de origem; os caminhos aqui apresentados são os nomes de destino após a migração."
  ],
  "indexes": [
    "usuario_id + status + atualizada_em decrescente.",
    "usuario_id + atualizada_em decrescente + _id decrescente.",
    "status + ultima_mensagem_em; status + atualizada_em para sessões antigas."
  ]
}
