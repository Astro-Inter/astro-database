{
  "name": "formularios",
  "title": "Formulários",
  "description": "Uma coleção física compartilhada, com escopo por workspace e um documento por formulário.",
  "status": "Implementada",
  "pattern": "Documentos e referências",
  "fields": [
    {
      "name": "_id",
      "type": "string",
      "description": "UUID do formulário.",
      "required": "Sim"
    },
    {
      "name": "workspace_id",
      "type": "number",
      "description": "Workspace PostgreSQL do formulário.",
      "required": "Sim"
    },
    {
      "name": "gestor_remetente_id",
      "type": "number",
      "description": "Usuário gestor que criou o formulário.",
      "required": "Sim"
    },
    {
      "name": "gestor_id",
      "type": "number | null",
      "description": "Usuário gestor destinatário; obrigatório ao publicar.",
      "required": "Não"
    },
    {
      "name": "nr_id",
      "type": "number | null",
      "description": "Código da NR vinculada.",
      "required": "Não",
      "references": "nrs"
    },
    {
      "name": "unidade_id",
      "type": "number | null",
      "description": "Unidade PostgreSQL vinculada.",
      "required": "Não"
    },
    {
      "name": "titulo",
      "type": "string",
      "description": "Título limpo, até 100 caracteres; sem marcador ac1.",
      "required": "Sim"
    },
    {
      "name": "descricao",
      "type": "string",
      "description": "Descrição, até 240 caracteres.",
      "required": "Não"
    },
    {
