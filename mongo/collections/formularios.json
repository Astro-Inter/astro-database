      "description": "Criação do documento.",
      "required": "Sim"
    },
    {
      "name": "atualizado_em",
      "type": "date",
      "description": "Última alteração.",
      "required": "Não"
    },
    {
      "name": "respondido_em",
      "type": "date | null",
      "description": "Instante da resposta; null antes do envio.",
      "required": "Não"
    },
    {
      "name": "perguntas",
      "type": "array<object>",
      "description": "Definições e respostas embutidas.",
      "required": "Sim"
    },
    {
      "name": "perguntas[].pergunta_id",
